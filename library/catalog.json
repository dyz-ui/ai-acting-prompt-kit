  "concepts": [
    {
      "id": "anchor",
      "cn": "主体位置",
      "en": "anchor / focal point",
      "rule": "主体放在三分点 0.333/0.667 或黄金点 0.382/0.618，忌正中",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 71
        },
        {
          "book": "picture-this",
          "chapter": "位置与情绪"
        }
      ],
      "code": "composition.anchor = thirds_left | golden_right | center | edge_left"
    },
    {
      "id": "thirds",
      "cn": "三分法",
      "en": "rule of thirds",
      "rule": "横竖各分三份，主体落在交点或分割线上",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 71
        },
        {
          "book": "samara",
          "chapter": "层级"
        }
      ],
      "code": "anchor: thirds_left/right; horizon: 0.34/0.66"
    },
    {
      "id": "golden",
      "cn": "黄金分割",
      "en": "golden section",
      "rule": "0.382 / 0.618，比三分更耐看",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 71
        },
        {
          "book": "arnheim",
          "chapter": "平衡"
        }
      ],
      "code": "anchor: golden_left/right"
    },
    {
      "id": "negative-space",
      "cn": "留白 / 负空间",
      "en": "negative space",
      "rule": "留白占 40–60%，且必须干净有质感；主体朝向侧留白 ≥ 反侧 1.5 倍",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 60
        },
        {
          "book": "picture-this",
          "chapter": "位置与情绪"
        }
      ],
      "code": "composition.negative_space = left | right",
      "quote": "if the work is balanced and the negative space is active, it brings energy to the form and its space. The focal point or figure increases its visual power because there is contrast for the eye. — p.60"
    },
    {
      "id": "visual-weight",
      "cn": "视觉重量",
      "en": "visual weight",
      "rule": "人脸>文字>动物>建筑>自然；亮>暗，饱和>灰，清晰>模糊",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 71
        },
        {
          "book": "arnheim",
          "chapter": "平衡"
        }
      ],
      "code": "字幕永远不压主体；主体明度高于背景"
    },
    {
      "id": "contrast",
      "cn": "对比",
      "en": "contrast",
      "rule": "相邻镜头在七维里至少 3 维同向变化，否则会散",
      "sources": [
        {
          "book": "visual-story",
          "chapter": "对比与亲和"
        },
        {
          "book": "bccampus-gd",
          "page": 60
        }
      ],
      "code": "节拍切换时检查：色相/明度/运动方向至少 3 项同向"
    },
    {
      "id": "hierarchy",
      "cn": "层级",
      "en": "hierarchy",
      "rule": "一屏只能有一个第一眼主体，字号/明度/位置三重区分",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 54
        },
        {
          "book": "williams",
          "chapter": "对比"
        }
      ],
      "code": "字幕字号 < 主体面积；标题与字幕不同权重"
    },
    {
      "id": "rhythm",
      "cn": "节奏",
      "en": "rhythm",
      "rule": "重复产生秩序，变化产生注意；节奏靠『间隔』而非元素本身",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 67
        },
        {
          "book": "visual-story",
          "chapter": "节奏"
        }
      ],
      "code": "每拍时长不等（5.5/7.4/7.1/6.2），忌均分"
    },
    {
      "id": "depth",
      "cn": "三层景深",
      "en": "three planes",
      "rule": "前景虚、中景实、背景灰；缺一层画面就扁",
      "sources": [
        {
          "book": "bccampus-gd",
          "page": 58
        },
        {
          "book": "framed-ink",
          "chapter": "大形状"
        }
      ],
      "code": "layers 顺序即景深：远山→近山→路面→电杆"
    },
    {
      "id": "leading-line",
      "cn": "引导线",
      "en": "leading line",
      "rule": "从画面边缘入画，终点必须落在主体，不能通向『无底洞』",
      "sources": [
        {
          "book": "framed-ink",
          "chapter": "视线流动"
        },
        {
          "book": "visual-story",
          "chapter": "线条与形状"
        }
      ],
      "code": "公路/江河/光路的收束点 = 主体位置"
    },
    {
      "id": "shape-language",
      "cn": "形状语言",
      "en": "shape language",
      "rule": "三角稳定、圆圆满、方庄重、不规则自然；斜线产生动感",
      "sources": [
        {
          "book": "kandinsky",
          "chapter": "点"
        },
        {
          "book": "picture-this",
          "chapter": "大小与威胁"
        }
      ],
      "code": "style.geometry = sharp | round | organic"
    },
    {
      "id": "color-relation",
      "cn": "色彩关系",
      "en": "color interaction",
      "rule": "颜色没有绝对值：同一灰在红底偏绿，在蓝底偏暖",
      "sources": [
        {
          "book": "albers",
          "chapter": "色彩相对性"
        }
      ],
      "code": "情绪 A→B 用 tint 混合（20% 权重），不做绝对赋值"
    },
    {
      "id": "grid",
      "cn": "网格",
      "en": "grid system",
      "rule": "所有元素落在栏与基线上；不规则是设计，不是随手",
      "sources": [
        {
          "book": "msb",
          "chapter": "网格构造"
        },
        {
          "book": "bccampus-gd",
          "page": 85
        }
      ],
      "code": "字幕 y = H-148，标题基线固定，不手调"
    },
    {
      "id": "texture",
      "cn": "肌理",
      "en": "texture",
      "rule": "适度不规则比完美对称耐看；颗粒要克制，否则压缩爆炸",
      "sources": [
        {
          "book": "gombrich",
          "chapter": "装饰与知觉"
        },
        {
          "book": "bccampus-gd",
          "page": 46
        }
      ],
      "code": "grain σ=3.0；crf 20 以下颗粒会让体积翻三倍"
    },
    {
      "id": "squint",
      "cn": "眯眼测试",
      "en": "squint test",
      "rule": "缩到 320px 还认得出主体，构图才算成立",
      "sources": [
        {
          "book": "framed-ink",
          "chapter": "大形状"
        }
      ],
      "code": "渲完抽帧 → scale=320:-1 → 人眼过一遍"
    },
    {
      "id": "affinity",
      "cn": "亲和",
      "en": "affinity",
      "rule": "与对比相对：连续两三拍保持同一维不变，观众才不会累",
      "sources": [
        {
          "book": "visual-story",
          "chapter": "对比与亲和"
        }
      ],
      "code": "同一族场景连续使用时，保持色调不变、只换构图"
    }
  ]
}
